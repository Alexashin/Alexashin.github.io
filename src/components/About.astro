---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import me from '../assets/me.jpg';
import { profile } from '../data/profile';
interface Props { achievements: CollectionEntry<'achievements'>[]; }
const { achievements } = Astro.props;
const awards = achievements.filter((a) => a.data.list === 'award').sort((a, b) => a.data.order - b.data.order);
const papers = achievements.filter((a) => a.data.list === 'paper').sort((a, b) => a.data.order - b.data.order);
---
<section id="about" class="section wrap" aria-labelledby="about-h">
  <div class="grid">
    <article class="letter" data-reveal>
      <div class="sheet">
        <Image class="face" src={me} alt={`Портрет: ${profile.name}`} width={96} height={96} densities={[1, 2]} />
        <h2 id="about-h">Привет, я Артем</h2>
        {profile.letter.map((t) => <p>{t}</p>)}
        <p class="sign">{profile.name}<span>{profile.role}, {profile.city}</span></p>
      </div>
      <div class="stub">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn" href={profile.telegram.url}>Написать в Telegram</a>
      </div>
    </article>

    <aside class="side" aria-label="Факты и достижения">
      <dl class="facts" data-reveal style="--d:1">
        {profile.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
      <div data-reveal style="--d:2">
        <h3>Достижения</h3>
        <ul class="list">{awards.map((a) => <li><span>{a.data.title}</span><span class="tnum y">{a.data.year}</span></li>)}</ul>
      </div>
      <div data-reveal style="--d:3">
        <h3>Публикации</h3>
        <ul class="list">{papers.map((a) => <li><span>{a.data.title}</span><span class="tnum y">{a.data.year}</span></li>)}</ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .letter { grid-column: 1 / span 7; align-self: start; }
  .sheet {
    --sc: 12px;
    background: var(--surface); padding: clamp(28px, 4.2vw, 60px); padding-bottom: calc(clamp(28px, 4.2vw, 60px) + var(--sc));
    display: flex; flex-direction: column; gap: 1em;
    /* низ листа срезан мелкими полукругами */
    -webkit-mask: radial-gradient(var(--sc) at 50% 100%, #0000 98%, #000) 50% / calc(var(--sc) * 2.4) 100% repeat-x;
            mask: radial-gradient(var(--sc) at 50% 100%, #0000 98%, #000) 50% / calc(var(--sc) * 2.4) 100% repeat-x;
  }
  .face { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; margin-bottom: 8px; }
  h2 { margin-bottom: 0.3em; }
  .sheet p { max-width: 60ch; }
  .sign { margin-top: 0.6em; font-size: var(--step-lead); font-weight: 600; letter-spacing: -0.02em; display: flex; flex-direction: column; }
  .sign span { font-size: var(--step-small); font-weight: 400; color: var(--muted); letter-spacing: 0; }
  /* Отрывной корешок: отделён рядом крупных точек */
  .stub { background: var(--surface); margin-top: 10px; padding: 18px clamp(28px, 4.2vw, 60px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; border-top: 5px dotted var(--surface-2); }
  .stub a:not(.btn) { overflow-wrap: anywhere; text-underline-offset: 0.25em; }
  .stub a:not(.btn):hover { color: var(--accent-text); }

  .side { grid-column: 9 / -1; display: flex; flex-direction: column; gap: 48px; }
  .facts { display: flex; flex-direction: column; gap: 18px; }
  dt { color: var(--muted); font-size: var(--step-small); }
  dd { margin-top: 2px; }
  h3 { font-size: var(--step-body); font-weight: 600; margin-bottom: 14px; }
  .list { display: flex; flex-direction: column; gap: 12px; font-size: var(--step-small); line-height: 1.4; }
  .list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; }
  .y { color: var(--muted); }

  @media (max-width: 1100px) { .letter { grid-column: 1 / span 7; } .side { grid-column: 8 / -1; } }
  @media (max-width: 900px) {
    .letter, .side { grid-column: 1 / -1; }
    .letter { margin-inline: calc(var(--m) * -1 + 8px); }
    .side { margin-top: 56px; }
    .stub .btn { width: 100%; }
  }
</style>
