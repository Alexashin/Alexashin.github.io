---
import type { CollectionEntry } from 'astro:content';
import { profile } from '../data/profile';
interface Props { achievements: CollectionEntry<'achievements'>[]; }
const { achievements } = Astro.props;
const awards = achievements.filter((a) => a.data.list === 'award').sort((a, b) => a.data.order - b.data.order);
const papers = achievements.filter((a) => a.data.list === 'paper').sort((a, b) => a.data.order - b.data.order);
---
<section id="about" class="section wrap" aria-label="Обо мне">
  <div class="row r1" data-reveal>
    <dl class="facts">
      {profile.facts.map((f) => <div><dt class="muted small">{f.label}</dt><dd>{f.value}</dd></div>)}
    </dl>
    <p class="lead">{profile.about}</p>
  </div>
  <div class="row r2" data-reveal>
    <h2 class="lab">Достижения</h2>
    <ul class="list">
      {awards.map((a) => <li><span>{a.data.title}</span><span class="muted tnum">{a.data.year}</span></li>)}
    </ul>
    <ul class="list">
      {papers.map((a) => <li><span>{a.data.title}</span><span class="muted tnum">{a.data.year}</span></li>)}
    </ul>
  </div>
  <div class="row r3" data-reveal>
    <h2 class="lab">Условия</h2>
    <ul class="terms">
      {profile.guarantees.map((g) => <li>{g}</li>)}
    </ul>
  </div>
</section>

<style>
  .row { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 0 clamp(24px, 6vw, 96px); }
  .r1 { align-items: start; }
  .facts { display: flex; flex-direction: column; gap: 20px; font-size: var(--step-body); line-height: 1.4; }
  .facts dd { margin-top: 2px; }
  .lead { font-size: var(--step-lead); line-height: 1.35; letter-spacing: -0.012em; max-width: 36em; }
  .r2, .r3 { margin-top: clamp(64px, 8vw, 120px); grid-template-columns: 12rem minmax(0, 1fr) minmax(0, 1fr); }
  .r3 { grid-template-columns: 12rem minmax(0, 1fr); }
  .lab { font-size: var(--step-body); font-weight: 600; letter-spacing: 0; line-height: 1.4; }
  .list { display: flex; flex-direction: column; gap: 16px; font-size: var(--step-body); line-height: 1.35; }
  .list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; }
  .list li span:last-child { text-align: right; }
  .terms { display: flex; flex-wrap: wrap; gap: 8px 40px; font-size: var(--step-body); }
  @media (max-width: 900px) {
    .row, .r2, .r3 { grid-template-columns: 1fr; }
    .r1 .lead { order: -1; font-size: 1.2rem; }
    .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px; }
    .facts div:first-child { grid-column: 1 / -1; }
    .lab { margin-bottom: 14px; font-size: var(--step-body); font-weight: 600; }
    .list + .list { margin-top: 36px; }
    .r2 { gap: 0; }
    .terms { flex-direction: column; gap: 6px; }
  }
</style>
