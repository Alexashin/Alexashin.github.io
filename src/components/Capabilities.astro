---
import type { CollectionEntry } from 'astro:content';
interface Props { groups: CollectionEntry<'services'>[]; }
const { groups } = Astro.props;
---
<section id="skills" class="section wrap" aria-labelledby="skills-h">
  <div class="grid">
    <h2 id="skills-h" class="h" data-reveal>Что делаю</h2>
    <p class="desc" id="desc" aria-live="polite" data-reveal style="--d:1"></p>
    {groups.map((g, gi) => (
      <div class={`g g${gi + 1}`} data-reveal style={`--d:${gi + 2}`}>
        <h3>{g.data.group}</h3>
        <ul>
          {g.data.items.map((it) => (
            <li><a href={it.project ? `/projects/${it.project}/` : '#work'} data-note={it.note}>{it.name}</a></li>
          ))}
        </ul>
        <p class="sum muted">{g.data.sum}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .h { grid-column: 1 / span 3; }
  .desc { grid-column: 4 / span 9; min-height: 3.2em; font-size: var(--step-lead); line-height: 1.25; letter-spacing: -0.01em; color: var(--accent); align-self: start; }
  .g { grid-column: span 3; margin-top: clamp(48px, 6vw, 96px); }
  .g h3 { font-size: var(--step-body); font-weight: 600; letter-spacing: -0.01em; margin-bottom: 1em; }
  .g ul { display: flex; flex-direction: column; }
  .g li a { display: block; padding: 3px 0; color: var(--muted); text-decoration: none; line-height: 1.25; transition: color 0.2s; }
  .g li a:hover, .g li a:focus-visible { color: var(--ink); }
  .sum { display: none; margin-top: 1.2em; font-size: var(--step-body); line-height: 1.4; }
  @media (max-width: 900px) {
    .h { grid-column: 1 / -1; }
    .desc { display: none; }
    .g { grid-column: 1 / -1; margin-top: 40px; }
    .g li a { padding: 5px 0; line-height: 1.4; }
    .sum { display: block; }
  }
  @media (min-width: 901px) and (max-width: 1200px) { .g { grid-column: span 6; } }
</style>

<script>
  const desc = document.getElementById('desc');
  document.querySelectorAll<HTMLAnchorElement>('#skills li a').forEach((a) => {
    const on = () => { if (desc) desc.textContent = a.dataset.note ?? ''; };
    a.addEventListener('mouseenter', on); a.addEventListener('focus', on);
  });
</script>
