---
import { profile } from '../data/profile';
const rows = [
  { label: 'Telegram', value: profile.telegram.handle, href: profile.telegram.url },
  { label: 'Звонок и MAX', value: profile.phone.display, href: `tel:${profile.phone.tel}` },
  { label: 'Почта', value: profile.email, href: `mailto:${profile.email}`, email: true },
];
---
<section id="contact" class="contact" aria-labelledby="contact-h">
  <a class="row hello" href={profile.telegram.url}>
    <span class="in wrap">
      <h2 id="contact-h" class="big">Напишите мне</h2>
      <span class="go" aria-hidden="true">→</span>
    </span>
  </a>
  {rows.map((r) => (
    <a class="row" href={r.href} data-reveal>
      <span class="in wrap">
        <span class="lab">{r.label}</span>
        <span class={`big${r.email ? ' email' : ''}`}>{r.value}</span>
      </span>
    </a>
  ))}
</section>

<style>
  .contact { margin-top: var(--section); }
  .row { display: block; text-decoration: none; background: var(--bg); transition: background 0.25s var(--ease); }
  .row:nth-of-type(odd) { background: var(--surface); }
  .in { display: grid; grid-template-columns: minmax(150px, 15%) minmax(0, 1fr); align-items: end; gap: 0 24px; min-height: clamp(96px, 10vw, 150px); padding-block: 20px 22px; }
  .lab { font-weight: 600; padding-bottom: 0.5em; }
  .big { font-size: var(--step-display); font-weight: 500; letter-spacing: -0.035em; line-height: 1; white-space: nowrap; }
  .email { font-size: var(--step-title); }
  a.row:hover { background: var(--surface-2); }
  a.row:hover .big { color: var(--accent); }
  a.row:focus-visible { outline-offset: -4px; }

  .hello { background: var(--accent) !important; color: var(--accent-ink); }
  .hello .in { grid-template-columns: minmax(0, 1fr) auto; }
  .hello .big { font-weight: 600; }
  .go { width: clamp(52px, 5.2vw, 84px); height: clamp(52px, 5.2vw, 84px); border-radius: 50%; background: var(--accent-ink); color: var(--accent); display: grid; place-items: center; font-size: clamp(1.5rem, 2.4vw, 2.5rem); line-height: 1; transition: transform 0.3s var(--ease); }
  .hello:hover .go { transform: translateX(8px); }
  .hello:hover { background: var(--ink) !important; }
  .hello:hover .big { color: var(--bg); }

  @media (max-width: 760px) {
    .in { grid-template-columns: minmax(0, 1fr); min-height: 0; padding-block: 18px; }
    .lab { order: 2; padding: 8px 0 0; font-weight: 400; color: var(--muted); font-size: var(--step-small); }
    .email { font-size: 6.4vw; }
    .hello .in { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .go { width: 56px; height: 56px; }
  }
</style>
