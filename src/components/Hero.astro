---
import { Image } from 'astro:assets';
import type { SheetFrame } from '../data/sheet';
import { profile } from '../data/profile';

interface Props { columns: SheetFrame[][]; }
const { columns } = Astro.props;
---
<section class="hero" aria-label="Начало">
  <div class="sheet" aria-hidden={false}>
    {columns.map((col, ci) => (
      <ul class={`col c${ci + 1}`}>
        {col.map((f, fi) => (
          <li class="frame" style={`--i:${ci * 2 + fi}`}>
            <a href={`/projects/${f.slug}/`} aria-label={`${f.label}: ${f.alt}`} tabindex={ci > 3 ? -1 : 0}>
              <div class="pic">
                <Image src={f.img} alt={f.alt} widths={[240, 480]} sizes="(max-width: 700px) 50vw, 17vw" loading="eager" decoding="async" />
              </div>
              <span class={`strip s${f.strip + 1}`} data-label={f.label} aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>

  <div class="overlay wrap">
    <div class="cell">
      <h1>{profile.name}</h1>
      <p class="lead">{profile.lead}</p>
      <a class="btn" href={profile.telegram.url}>Написать в Telegram</a>
      <p class="links small">
        <a href="#work">Проекты</a>
        <a href="#about">Обо мне</a>
        <a href={`mailto:${profile.email}`}>Почта</a>
        <a href={`tel:${profile.phone.tel}`}>Позвонить</a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 100svh; min-height: 640px; overflow: hidden; background: var(--bg); }
  .sheet { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--gap); padding: var(--gap) var(--m) 0; height: 100%; }
  .col { display: flex; flex-direction: column; gap: var(--gap); }
  .c1 { margin-top: 0; } .c2 { margin-top: -90px; } .c3 { margin-top: -40px; }
  .c4 { margin-top: -130px; } .c5 { margin-top: -20px; } .c6 { margin-top: -70px; }

  .frame a { display: block; text-decoration: none; }
  .pic { overflow: hidden; background: var(--surface); }
  .pic :global(img) { width: 100%; height: auto; transition: transform 0.6s var(--ease), filter 0.3s; }
  .frame a:hover .pic :global(img) { transform: scale(1.03); }
  .strip { display: block; height: 28px; line-height: 28px; padding: 0 10px; font-size: var(--step-small); white-space: nowrap; overflow: hidden; }
  .strip::after { content: attr(data-label); }
  .s1 { background: var(--s1); color: var(--s1-ink); } .s2 { background: var(--s2); color: var(--s2-ink); }
  .s3 { background: var(--s3); color: var(--s3-ink); } .s4 { background: var(--s4); color: var(--s4-ink); }

  /* Шторка: кадр раскрывается сверху вниз, картинка оседает с 1.12 */
  .frame { animation: shutter 1.1s var(--ease) both; animation-delay: calc(var(--i) * 65ms + 150ms); }
  .frame .pic :global(img) { animation: settle 1.4s var(--ease) both; animation-delay: calc(var(--i) * 65ms + 150ms); }
  @keyframes shutter { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes settle { from { transform: scale(1.12); } to { transform: scale(1); } }

  .overlay { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: var(--gap); pointer-events: none; align-content: start; }
  .cell { grid-column: 3 / span 3; margin-top: 22svh; background: var(--ink); color: var(--bg); padding: clamp(24px, 2.4vw, 36px); pointer-events: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; animation: cellin 0.9s var(--ease) 0.9s both; }
  @keyframes cellin { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  h1 { font-size: var(--step-display); line-height: 0.94; }
  .lead { font-size: var(--step-lead); line-height: 1.3; letter-spacing: -0.01em; max-width: 26ch; }
  .cell .btn { background: var(--bg); color: var(--ink); margin-top: 6px; }
  .cell .btn:hover { background: var(--accent); color: var(--accent-ink); }
  .links { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  .links a { text-decoration-color: color-mix(in srgb, var(--bg) 40%, transparent); }

  @media (max-width: 1100px) { .cell { grid-column: 2 / span 5; } }
  @media (max-width: 700px) {
    .hero { height: auto; min-height: 0; display: flex; flex-direction: column; }
    .overlay { position: static; display: block; order: -1; padding-top: var(--gap); }
    .cell { margin: 0; min-height: 40svh; justify-content: flex-end; }
    .cell .btn { width: 100%; }
    .sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); height: 85svh; padding-top: var(--gap); }
    .col:nth-child(n + 3) { display: none; }
    .c1 { margin-top: 0; } .c2 { margin-top: -60px; }
  }
</style>
