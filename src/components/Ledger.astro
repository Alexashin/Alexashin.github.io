---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
const kinds: Record<string, string> = { bot: 'Боты', web: 'Веб', data: 'Данные', iot: 'IoT', audio: 'Аудио' };
const present = Object.keys(kinds).filter((k) => projects.some((p) => p.data.kind === k));
---
<section id="work" class="section wrap" aria-labelledby="work-h">
  <div class="grid">
    <div class="head" data-reveal>
      <h2 id="work-h">Проекты</h2>
    </div>
    <div class="list" data-reveal style="--d:1">
      <div class="filters small" role="group" aria-label="Фильтр по типу">
        <button type="button" data-kind="all" aria-pressed="true">Все <span class="tnum">{projects.length}</span></button>
        {present.map((k) => <button type="button" data-kind={k} aria-pressed="false">{kinds[k]} <span class="tnum">{projects.filter((p) => p.data.kind === k).length}</span></button>)}
      </div>
      <ol class="rows">
        {projects.map((p, i) => (
          <li data-kind={p.data.kind} data-i={i}>
            {i < 3 && <div class="mpic"><Image src={p.data.cover} alt="" widths={[480, 800]} sizes="100vw" loading="lazy" /></div>}
            <a href={`/projects/${p.id}/`} class="row">
              <span class="name">{p.data.title}</span>
              <span class="type muted">{p.data.type}</span>
              <span class="year muted tnum">{p.data.year}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="all small"><a href="/projects/">Все кадры одним листом</a></p>
    </div>
    <div class="preview" aria-hidden="true">
      {projects.map((p, i) => (
        <div class="pv" data-i={i} data-on={i === 0 ? '1' : '0'}>
          <Image src={p.data.cover} alt="" widths={[640, 960]} sizes="40vw" loading={i === 0 ? 'eager' : 'lazy'} />
          <p class="small muted">{p.data.summary}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { grid-column: 1 / span 2; }
  .list { grid-column: 3 / span 5; }
  .preview { grid-column: 8 / span 5; position: relative; align-self: start; position: sticky; top: 32px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-bottom: 20px; }
  .filters button { color: var(--muted); padding: 6px 0; border-bottom: 2px solid transparent; transition: color 0.2s; }
  .filters button:hover { color: var(--ink); }
  .filters button[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--accent); }
  .rows { display: block; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) 7.5rem 3rem; gap: 16px; align-items: baseline; padding: 12px 0; min-height: 52px; text-decoration: none; transition: color 0.2s; }
  .name { font-size: var(--step-body); font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; }
  .type, .year { font-size: var(--step-small); }
  .year { text-align: right; }
  .mpic { display: none; }
  .rows li[hidden] { display: none; }
  .rows:hover .row, .rows:focus-within .row { color: var(--muted); }
  .rows .row:hover, .rows .row:focus-visible { color: var(--ink); }
  .rows:hover .row:hover .type, .rows:hover .row:hover .year { color: var(--muted); }
  .all { margin-top: 28px; }

  .pv { display: none; }
  .pv[data-on='1'] { display: block; animation: pvin 0.5s var(--ease) both; }
  .pv :global(img) { width: 100%; height: auto; background: var(--surface); }
  .pv p { margin-top: 12px; max-width: 46ch; }
  @keyframes pvin { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }

  @media (max-width: 900px) {
    .type, .year, .filters, .all { font-size: 1rem; }
    .head { grid-column: 1 / -1; margin-bottom: 24px; }
    .list { grid-column: 1 / -1; }
    .preview { display: none; }
    .row { grid-template-columns: minmax(0, 1fr) auto; padding: 14px 0; }
    .type { grid-column: 1; grid-row: 2; }
    .year { grid-column: 2; grid-row: 1; }
    .mpic { display: block; margin-top: 20px; }
    .mpic :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  }
</style>

<script>
  const section = document.getElementById('work');
  if (section) {
    const pv = section.querySelectorAll<HTMLElement>('.pv');
    const show = (i: string | undefined) => pv.forEach((el) => (el.dataset.on = el.dataset.i === i ? '1' : '0'));
    section.querySelectorAll<HTMLElement>('.rows li').forEach((li) => {
      const a = li.querySelector('a');
      a?.addEventListener('mouseenter', () => show(li.dataset.i));
      a?.addEventListener('focus', () => show(li.dataset.i));
    });
    const btns = section.querySelectorAll<HTMLButtonElement>('.filters button');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let first: string | undefined;
      section.querySelectorAll<HTMLElement>('.rows li').forEach((li) => {
        const ok = b.dataset.kind === 'all' || li.dataset.kind === b.dataset.kind;
        li.hidden = !ok;
        if (ok && first === undefined) first = li.dataset.i;
      });
      show(first);
    }));
  }
</script>
