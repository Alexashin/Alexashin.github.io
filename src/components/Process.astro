---
import { profile } from '../data/profile';
const steps = profile.process;
---
<section id="process" class="section wrap" aria-labelledby="process-h">
  <ol class="grid stairs">
    {steps.map((s, i) => (
      <li style={`--s:${i}`} data-reveal>
        {i === 0
          ? <h2 id="process-h" class="line">{s.line}</h2>
          : <p class={`line${i === steps.length - 1 ? ' last' : ''}`}>{s.line}</p>}
        <p class="note">{s.note}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .stairs { row-gap: 56px; }
  li { grid-column: calc(1 + var(--s) * 2) / -1; }
  .line { font-size: var(--step-display); font-weight: 600; letter-spacing: -0.035em; line-height: 1; text-wrap: balance; }
  .last { color: var(--accent-text); }
  .note { margin-top: 14px; max-width: 40ch; color: var(--muted); }

  @media (max-width: 900px) {
    .stairs { display: flex; flex-direction: column; gap: 40px; }
    li { padding-left: calc(var(--s) * 6vw); }
  }
</style>
