---
import type { CollectionEntry } from 'astro:content';
interface Props { groups: CollectionEntry<'services'>[]; }
const { groups } = Astro.props;
---
<section id="services" class="section wrap" aria-labelledby="services-h">
  <div class="grid">
    <div class="intro">
      <h2 id="services-h" data-reveal>Услуги и цены</h2>
      <p class="lead" data-reveal style="--d:1">Цены стартовые. Точную сумму и срок называю после разговора о задаче, до начала работы, одной цифрой.</p>
      <p class="hint muted" data-reveal style="--d:2">Название со стрелкой ведёт к проекту, где это уже сделано.</p>
    </div>

    <div class="sheet" data-reveal style="--d:1">
      {groups.map((g) => (
        <div class="group">
          <h3>{g.data.group}</h3>
          <ul>
            {g.data.items.map((it) => (
              <li>
                <div class="row">
                  {it.project
                    ? <a class="name" href={`/projects/${it.project}/`}>{it.name} <span aria-hidden="true">→</span></a>
                    : <span class="name">{it.name}</span>}
                  <span class="dots" aria-hidden="true"></span>
                  <span class="price tnum">{it.price}</span>
                </div>
                <p class="note">{it.note}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .intro { grid-column: 1 / span 5; position: sticky; top: calc(var(--bar) + 24px); align-self: start; display: flex; flex-direction: column; gap: 24px; }
  .lead { font-size: var(--step-lead); line-height: 1.3; letter-spacing: -0.01em; max-width: 24ch; }
  .hint { font-size: var(--step-small); max-width: 34ch; }

  /* Лист прайса: верх и низ срезаны зигзагом */
  .sheet {
    --z: 14px;
    grid-column: 7 / -1; background: var(--paper); color: var(--paper-ink);
    padding: calc(var(--z) + clamp(28px, 3.4vw, 52px)) clamp(22px, 3.4vw, 56px);
    display: flex; flex-direction: column; gap: 44px;
    clip-path: polygon(
      0 var(--z), 5% 0, 10% var(--z), 15% 0, 20% var(--z), 25% 0, 30% var(--z), 35% 0, 40% var(--z), 45% 0, 50% var(--z), 55% 0, 60% var(--z), 65% 0, 70% var(--z), 75% 0, 80% var(--z), 85% 0, 90% var(--z), 95% 0, 100% var(--z),
      100% calc(100% - var(--z)), 95% 100%, 90% calc(100% - var(--z)), 85% 100%, 80% calc(100% - var(--z)), 75% 100%, 70% calc(100% - var(--z)), 65% 100%, 60% calc(100% - var(--z)), 55% 100%, 50% calc(100% - var(--z)), 45% 100%, 40% calc(100% - var(--z)), 35% 100%, 30% calc(100% - var(--z)), 25% 100%, 20% calc(100% - var(--z)), 15% 100%, 10% calc(100% - var(--z)), 5% 100%, 0 calc(100% - var(--z))
    );
  }
  h3 { font-size: var(--step-lead); font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 18px; }
  ul { display: flex; flex-direction: column; gap: 18px; }
  .row { display: flex; align-items: baseline; gap: 10px; }
  .name { font-weight: 600; text-decoration: none; }
  a.name:hover { color: var(--paper-accent); text-decoration: underline; text-underline-offset: 0.2em; }
  .dots { flex: 1; min-width: 24px; border-bottom: 4px dotted color-mix(in srgb, var(--paper-ink) 35%, transparent); transform: translateY(-0.25em); }
  .price { font-weight: 600; white-space: nowrap; }
  .note { margin-top: 2px; color: var(--paper-muted); font-size: var(--step-small); max-width: 40ch; }

  @media (max-width: 900px) {
    .intro { grid-column: 1 / -1; position: static; margin-bottom: 36px; }
    .sheet { grid-column: 1 / -1; margin-inline: calc(var(--m) * -1 + 8px); --z: 10px; }
  }
</style>
