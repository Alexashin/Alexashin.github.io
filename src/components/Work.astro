---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
const kinds: Record<string, string> = { bot: 'Боты', web: 'Веб', data: 'Данные', iot: 'IoT', audio: 'Аудио' };
const present = Object.keys(kinds).filter((k) => projects.some((p) => p.data.kind === k));
const H = 220; // высота кадров в полосе на компьютере, px
// Короткая полоса (1–2 кадра): подпись встаёт справа от кадров, чтобы не было пустоты
const isShort = (p: CollectionEntry<'projects'>) =>
  p.data.gallery.slice(0, 6).reduce((w, g) => w + (H * g.src.width) / g.src.height + 8, 0) < 760;
---
<section id="work" class="work" aria-labelledby="work-h">
  <div class="rail wrap">
    <h2 id="work-h" data-reveal>Проекты</h2>
    <div class="filters" role="group" aria-label="Фильтр по типу" data-reveal style="--d:1">
      <button type="button" data-kind="all" aria-pressed="true">Все <span class="tnum">{projects.length}</span></button>
      {present.map((k) => <button type="button" data-kind={k} aria-pressed="false">{kinds[k]} <span class="tnum">{projects.filter((p) => p.data.kind === k).length}</span></button>)}
    </div>
    <a class="all" href="/projects/" data-reveal style="--d:2">Все кадры одним листом</a>
  </div>

  <ol class="strips">
    {projects.map((p) => (
      <li data-kind={p.data.kind}>
        <a href={`/projects/${p.id}/`} class={`item${isShort(p) ? ' short' : ''}`} aria-label={`${p.data.title}. ${p.data.summary}`}>
          <div class="strip" data-reveal>
            {p.data.gallery.slice(0, 6).map((g) => (
              <div class="shot" style={`--r:${g.src.width / g.src.height}`}>
                <Image src={g.src} alt="" height={H} densities={[1, 2]} loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
          <div class="cap" data-reveal style="--d:1">
            <span class="name">{p.data.title}</span>
            <span class="sum">{p.data.summary}</span>
            <span class="meta tnum">{p.data.type} · {p.data.year}</span>
          </div>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .work { padding-top: var(--section); }
  /* Шапка раздела строкой: заголовок, фильтры, ссылка на лист */
  .rail { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 40px; margin-bottom: clamp(32px, 4vw, 56px); }
  .filters { display: flex; flex-wrap: wrap; gap: 4px 22px; font-size: var(--step-small); }
  .filters button { color: var(--muted); padding: 6px 0; transition: color 0.2s; }
  .filters button:hover { color: var(--ink); }
  .filters button[aria-pressed='true'] { color: var(--ink); font-weight: 600; }
  .filters button[aria-pressed='true']::before { content: ''; display: inline-block; width: 8px; height: 8px; background: var(--accent); margin-right: 8px; vertical-align: 0.1em; }
  .all { font-size: var(--step-small); color: var(--ink); text-underline-offset: 0.3em; }
  .all:hover { color: var(--accent-text); }

  .strips { display: flex; flex-direction: column; gap: clamp(48px, 5vw, 72px); min-width: 0; }
  .strips li[hidden] { display: none; }
  .item { display: block; text-decoration: none; }
  .strip { display: flex; gap: 8px; overflow: hidden; height: 220px; }
  .shot { flex: none; height: 100%; aspect-ratio: var(--r); background: var(--surface); overflow: hidden; }
  .shot :global(img) { height: 100%; width: auto; transition: transform 0.5s var(--ease), opacity 0.3s; }
  .item:hover .shot :global(img) { transform: scale(1.03); }
  .strips:hover .item:not(:hover) .shot :global(img) { opacity: 0.4; }

  .cap { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto; gap: 8px 32px; align-items: baseline; padding: 18px var(--m) 0 0; }
  .name { font-size: var(--step-lead); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; transition: color 0.2s; }
  .item:hover .name, .item:focus-visible .name { color: var(--accent-text); }
  .sum { color: var(--ink); font-size: var(--step-body); line-height: 1.45; max-width: 52ch; }
  .meta { color: var(--muted); font-size: var(--step-small); white-space: nowrap; }

  .strip { padding-left: var(--m); }
  .cap { padding-left: var(--m); }
  @media (min-width: 1101px) {
    .short { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 40px; align-items: start; }
    .short .strip { padding-left: var(--m); }
    .short .cap { grid-template-columns: minmax(0, 1fr); padding: 0 var(--m) 0 0; row-gap: 14px; }
  }

  @media (max-width: 1100px) {
    .cap { grid-template-columns: minmax(0, 1fr) auto; }
    .sum { grid-column: 1 / -1; grid-row: 2; }
  }
  @media (max-width: 760px) {
    .work { display: block; }
    .rail { justify-content: space-between; gap: 12px; margin-bottom: 28px; }
    .filters { gap: 4px 16px; width: 100%; order: 3; }
    .filters button[aria-pressed='true']::before { display: none; }
    .filters button[aria-pressed='true'] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.4em; }
    .strip { height: 150px; overflow-x: auto; scroll-snap-type: x mandatory; padding-inline: var(--m); scroll-padding-inline: var(--m); scrollbar-width: none; }
    .strip::-webkit-scrollbar { display: none; }
    .shot { scroll-snap-align: start; }
    .cap { grid-template-columns: minmax(0, 1fr); }
    .meta { grid-row: 3; }
    .strips:hover .item:not(:hover) .shot :global(img) { opacity: 1; }
  }
</style>

<script>
  const section = document.getElementById('work');
  if (section) {
    const btns = section.querySelectorAll<HTMLButtonElement>('.filters button');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      section.querySelectorAll<HTMLElement>('.strips li').forEach((li) => {
        li.hidden = !(b.dataset.kind === 'all' || li.dataset.kind === b.dataset.kind);
      });
    }));
  }
</script>
