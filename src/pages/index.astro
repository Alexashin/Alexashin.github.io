---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ledger from '../components/Ledger.astro';
import Capabilities from '../components/Capabilities.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { buildSheet } from '../data/sheet';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const groups = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const achievements = await getCollection('achievements');
const columns = buildSheet(projects);
---
<Base>
  <main>
    <Hero columns={columns} />
    <Ledger projects={projects} />
    <Capabilities groups={groups} />
    <About achievements={achievements} />
    <Contact />
  </main>
  <Footer />
</Base>
