---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteBar from '../../components/SiteBar.astro';
import Runs from '../../components/Runs.astro';
import Lightbox from '../../components/Lightbox.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: all[(i + 1) % all.length] } }));
}
const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={d.title} description={d.summary} path={`/projects/${project.id}/`}>
  <SiteBar />
  <main>
    <header class="top wrap grid">
      <h1 data-reveal>{d.title}</h1>
      <p class="sum" data-reveal style="--d:1">{d.summary}</p>
    </header>

    {d.gallery.length <= 2 ? (
      <section class="split wrap grid" aria-label="Кадры и цифры">
        <div class="pic" data-reveal><Runs project={project} height={460} fit={780} /></div>
        {d.metrics.length > 0 && (
          <ul class="stack" data-reveal style="--d:1">
            {d.metrics.map((m) => <li><span class="v">{m.value}</span><span class="l small">{m.label}</span></li>)}
          </ul>
        )}
      </section>
    ) : (
      <>
        <section class="shots wrap" aria-label="Кадры проекта">
          <Runs project={project} height={d.gallery[0]?.frame === 'mobile' ? 420 : 300} />
        </section>
        {d.metrics.length > 0 && (
          <section class="metrics" aria-label="Цифры">
            <ul class="wrap" style={`--n:${d.metrics.length}`}>
              {d.metrics.map((m, i) => <li data-reveal style={`--d:${i}`}><span class="v">{m.value}</span><span class="l small">{m.label}</span></li>)}
            </ul>
          </section>
        )}
      </>
    )}

    <div class="body wrap grid">
      <aside class="meta small" data-reveal>
        <dl>
          <div><dt class="muted">Заказчик</dt><dd>{d.client}</dd></div>
          <div><dt class="muted">Тип</dt><dd>{d.type}, {d.year}</dd></div>
          <div><dt class="muted">Стек</dt><dd>{d.stack.join(', ')}</dd></div>
          {d.repo && <div><dt class="muted">Код</dt><dd><a href={d.repo}>Репозиторий на GitHub</a></dd></div>}
        </dl>
      </aside>
      <article class="prose" data-reveal style="--d:1"><Content /></article>
    </div>

    <nav class="next wrap" data-reveal aria-label="Следующий проект">
      <a href={`/projects/${next.id}/`}>
        <span class="small muted">Следующий проект</span>
        <span class="nt">{next.data.title}</span>
      </a>
    </nav>
  </main>
  <Footer />
  <Lightbox />
</Base>

<style>
  .top { padding-top: clamp(32px, 6vw, 88px); padding-bottom: clamp(32px, 4vw, 56px); row-gap: 20px; }
  .top > h1, .top > .sum { grid-column: 1 / span 10; }
  h1 { font-size: var(--step-display); line-height: 0.98; max-width: 16em; }
  .sum { font-size: var(--step-lead); line-height: 1.3; max-width: 34em; letter-spacing: -0.01em; }
  .shots { padding-block: 0; }
  .split { align-items: start; row-gap: 32px; }
  .pic { grid-column: 1 / span 8; }
  .stack { grid-column: 9 / -1; display: flex; flex-direction: column; gap: 32px; background: var(--surface); padding: clamp(24px, 3vw, 40px); }
  .stack li { display: flex; flex-direction: column; gap: 4px; }
  @media (max-width: 900px) { .pic, .stack { grid-column: 1 / -1; } }
  .metrics { background: var(--surface); margin-top: clamp(40px, 5vw, 72px); }
  .metrics ul { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 24px var(--gap); padding-block: clamp(32px, 4vw, 56px); }
  .metrics li { display: flex; flex-direction: column; gap: 4px; }
  .v { font-size: var(--step-display); font-weight: 600; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .l { color: var(--muted); max-width: 18ch; }
  .body { margin-top: clamp(56px, 8vw, 120px); align-items: start; }
  .meta { grid-column: 1 / span 3; position: sticky; top: 24px; }
  .meta dl { display: flex; flex-direction: column; gap: 18px; }
  .meta dd { margin-top: 2px; }
  .prose { grid-column: 5 / -1; }
  .prose :global(h2) { font-size: var(--step-lead); letter-spacing: -0.02em; line-height: 1.1; margin: 2.2em 0 0.7em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(li) { max-width: 62ch; }
  .prose :global(ul) { display: flex; flex-direction: column; gap: 0.6em; padding-left: 1.1em; list-style: disc; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(a) { color: var(--accent); }
  .prose :global(code) { font: inherit; background: var(--surface-2); padding: 0 0.25em; }
  .next { margin-top: var(--section); }
  .next a { display: block; text-decoration: none; background: var(--surface); padding: clamp(24px, 4vw, 56px); transition: background 0.25s; }
  .next a:hover { background: var(--surface-2); }
  .nt { display: block; margin-top: 8px; font-size: var(--step-title); font-weight: 600; letter-spacing: -0.03em; line-height: 1.02; max-width: 18em; }
  @media (max-width: 600px) { h1 { font-size: 1.5rem; } }
  @media (max-width: 900px) {
    .top > h1, .top > .sum { grid-column: 1 / -1; }
    .metrics ul { grid-template-columns: 1fr 1fr; }
    .meta dl { display: grid; grid-template-columns: 1fr 1fr; }
    .nt { font-size: 1.375rem; }
    .next a { padding: 20px; }
    .meta { grid-column: 1 / -1; position: static; margin-bottom: 40px; }
    .prose { grid-column: 1 / -1; }
  }
</style>
