---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteBar from '../../components/SiteBar.astro';
import Runs from '../../components/Runs.astro';
import Lightbox from '../../components/Lightbox.astro';
import Footer from '../../components/Footer.astro';
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const total = projects.reduce((n, p) => n + p.data.gallery.length, 0);
---
<Base title="Проекты" description="Все проекты одним листом: реальные экраны панелей, ботов, табло и плагина." path="/projects/">
  <SiteBar current="work" />
  <main class="wrap">
    <h1>Все проекты</h1>
    <p class="lead muted">{projects.length} проектов, {total} кадров из рабочих систем. Нажмите на кадр, чтобы открыть его крупно.</p>
    {projects.map((p) => (
      <section class="run-block grid" aria-labelledby={`h-${p.id}`} data-reveal>
        <div class="cap">
          <h2 id={`h-${p.id}`}><a href={`/projects/${p.id}/`}>{p.data.title}</a></h2>
          <p class="muted small">{p.data.type}, {p.data.year}</p>
        </div>
        <div class="frames"><Runs project={p} fit={960} height={p.data.gallery.length === 1 ? 340 : p.data.gallery[0]?.frame === 'mobile' ? 300 : p.data.gallery.length < 4 ? 220 : 170} /></div>
      </section>
    ))}
  </main>
  <Footer />
  <Lightbox />
</Base>
<style>
  h1 { font-size: var(--step-display); margin-top: clamp(32px, 6vw, 80px); }
  .lead { font-size: var(--step-lead); margin-top: 20px; max-width: 30em; line-height: 1.3; }
  .run-block { margin-top: clamp(40px, 6vw, 72px); }
  .cap { grid-column: 1 / span 3; padding-right: 16px; }
  .frames { grid-column: 4 / -1; }
  .cap h2 { font-size: var(--step-body); font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; text-wrap: auto; margin-bottom: 6px; }
  @media (max-width: 900px) { .cap, .frames { grid-column: 1 / -1; } .cap { margin-bottom: 14px; } }
  .cap a { text-decoration: none; }
  .cap a:hover { text-decoration: underline; }
</style>
